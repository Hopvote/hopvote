# Settings of your copy of Hopvote, read by Vite (npm run dev, npm run build). npm run setup copies this file to .env.
# The worker has its own settings: wrangler.jsonc (from wrangler.example.jsonc) and .dev.vars.

# "1": npm run dev works without a Cloudflare login, but writing help and translations are off on your machine
# (Workers AI only runs on Cloudflare). To use them locally: npx wrangler login, then empty this line.
HOPVOTE_LOCAL_ONLY=1

# The address people join at, shown with the QR code, no trailing slash: your domain (https://polls.example.com), or your
# computer's network address (http://192.168.1.20:5180) to try it with phones on the same Wi-Fi. Empty: this page's address.
VITE_PUBLIC_URL=
# Contact address shown in the help inside the app.
VITE_CONTACT_EMAIL=
# Link to the source code of your copy. The AGPL asks you to offer it to your users when you change the code.
VITE_SOURCE_URL=
