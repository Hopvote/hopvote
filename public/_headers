# Built files carry a hash in their name: they never change, browsers keep them a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Photos, logos and fonts change rarely: a month in the browser, a day before revalidating at the edge.
/photos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/logos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=604800

# Private pages stay out of search results.
# Signed-in pages and sign-in pages are never framed by another site.
/app
  X-Robots-Tag: noindex
  Content-Security-Policy: frame-ancestors 'self'
/app/*
  X-Robots-Tag: noindex
  Content-Security-Policy: frame-ancestors 'self'
/login
  X-Robots-Tag: noindex
/verify
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer
  Content-Security-Policy: frame-ancestors 'self'
/reset
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer
  Content-Security-Policy: frame-ancestors 'self'
/
  X-Robots-Tag: noindex
  Content-Security-Policy: frame-ancestors 'self'
/auth/google
  Content-Security-Policy: frame-ancestors 'self'
/team/join
  Content-Security-Policy: frame-ancestors 'self'
/forgot
  X-Robots-Tag: noindex
/preview/*
  X-Robots-Tag: noindex

# Sign-in pages send strict security headers.
/login
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self'; frame-ancestors 'self'
/signup
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self'; frame-ancestors 'self'
/forgot
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self'; frame-ancestors 'self'

# The live screen sends the same security headers.
/present/*
  X-Robots-Tag: noindex
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' https://www.youtube-nocookie.com https://player.vimeo.com https://w.soundcloud.com https://open.spotify.com https://drive.google.com; media-src 'self' https: blob:; frame-ancestors 'self'
